# API principal (emulador Android: use 10.0.2.2 em vez de localhost)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api

# Habilita a visualização e o envio de imagens nas doações (padrão: false)
EXPO_PUBLIC_IMAGE_UPLOAD_ENABLED=false

# Ambientes extras no FAB DEV (opcional)
# EXPO_PUBLIC_API_URL_2=http://192.168.0.10:3001/api
# EXPO_PUBLIC_API_URL_2_LABEL=PC na rede
# EXPO_PUBLIC_API_URL_3=
# EXPO_PUBLIC_API_URL_3_LABEL=

# Lista customizada (JSON ou Label|url,Label2|url2)
# EXPO_PUBLIC_API_DEV_OPTIONS=[{"label":"Render","url":"https://..."}]
# EXPO_PUBLIC_API_DEV_PRESETS=Local|http://10.0.2.2:3001/api,Produção|https://...
